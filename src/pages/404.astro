---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="404 — Page Not Found" description="This page doesn't exist on bhuvneshverma.dev.">
    <section class="mb-48 text-center" aria-label="Page not found">
        <p class="text-sm tracking-widest text-main/70 uppercase">404</p>
        <h2 class="mt-3 text-lg font-medium">This page doesn't exist.</h2>
        <p class="text-main/70 mt-2 text-sm">Use the links in the header, or head back home.</p>
        <a
            href="/"
            class="text-main/70 mt-6 inline-flex items-center gap-2 underline decoration-2 underline-offset-2 decoration-[color-mix(in_oklab,var(--text-main)_40%,transparent)] hover:text-main hover:decoration-[var(--text-main)]"
        >
            <svg
                class="h-4 w-4"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
            >
                <path d="M19 12H5m0 0 6 6m-6-6 6-6" />
            </svg>
            Back home
        </a>
    </section>
</BaseLayout>
