---
import Contact from '../components/Contact.astro';
import Experience from '../components/Experience.astro';
import Profile from '../components/Profile.astro';
import Projects from '../components/Projects.astro';
import Skills from '../components/Skills.astro';
import Testimonials from '../components/Testimonials.astro';
import BaseLayout from '../layouts/BaseLayout.astro';

const profilePage = {
    '@type': 'ProfilePage',
    '@id': new URL('/', Astro.site).toString() + '#profile',
    url: new URL('/', Astro.site).toString(),
    name: 'Bhuvnesh Verma — Cloud-Native Full-Stack & AI Engineer',
    mainEntity: { '@id': new URL('/#bhuvneshverma', Astro.site).toString() },
    dateModified: new Date().toISOString()
};
---

<BaseLayout
    title="Cloud-Native Full-Stack & AI Engineer"
    description="Bhuvnesh Verma, cloud-native full-stack and AI engineer in Nagpur, India. Building reliable web, mobile, cloud and AI systems, plus a visual system design roadmap."
    schema={[profilePage]}
>
    <Profile />
    <Projects />
    <Experience />
    <Testimonials />
    <Skills />
    <Contact />
</BaseLayout>
