---
import { systemDesignSections } from '../../data/system-design-sections';
import roadmapRows from '../../data/system-design-sheet.json';
import BaseLayout from '../../layouts/BaseLayout.astro';

const section = systemDesignSections.find((s) => s.id === 'fundamentals')!;

type TopicItem = { title: string; href?: string };
function rowTopics(row: any): TopicItem[] {
    const boxes = [...(row.left ?? []), ...(row.right ?? [])].filter(
        (c: any) => c?.kind === 'box'
    );
    const grid: TopicItem[] = [];
    for (const g of row.below ?? []) {
        if (g?.kind !== 'group') continue;
        for (const b of g.blocks ?? []) {
            for (const it of b.items ?? []) {
                if (Array.isArray(it)) {
                    for (const cell of it) {
                        if (cell && typeof cell === 'object') grid.push(cell);
                    }
                } else if (it && typeof it === 'object') {
                    grid.push(it);
                }
            }
        }
    }
    return [...boxes, ...grid];
}
const rowsWithTopics = roadmapRows
    .map((row: any) => ({ center: row.center as string, topics: rowTopics(row) }))
    .filter((r) => r.topics.length > 0);
---

<BaseLayout title={section.title} description={section.description} showHeader={false}>
    <h1 class="mb-4 font-sans text-2xl leading-tight sm:text-4xl">{section.title}</h1>
    <p class="mb-12 text-sm leading-relaxed text-main/70 sm:mb-16 lg:text-[18px]">{section.description}</p>
    <div class="mb-16 sm:mb-24">
        {rowsWithTopics.map((row) => (
            <div class="mb-10 sm:mb-12">
                <h3 class="mb-3 font-sans text-base font-medium">{row.center}</h3>
                <p class="flex flex-wrap gap-x-5 gap-y-2 text-sm leading-relaxed">
                    {row.topics.map((t) =>
                        t.href ? (
                            <a
                                class="text-main/70 underline decoration-1 underline-offset-2 transition hover:text-main hover:decoration-[var(--text-main)]"
                                href={t.href}
                            >
                                {t.title}
                            </a>
                        ) : (
                            <span class="opacity-60">{t.title}</span>
                        )
                    )}
                </p>
            </div>
        ))}
    </div>
</BaseLayout>
