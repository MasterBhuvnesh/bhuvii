---
import { getCollection } from 'astro:content';
import ArrowRight from '../assets/icons/arrow-right.svg';
import { systemDesignSections } from '../data/system-design-sections';
import BaseLayout from '../layouts/BaseLayout.astro';
import { sortItemsByDateDesc } from '../utils/data-utils';

const posts = (await getCollection('systemDesign')).sort(sortItemsByDateDesc);

// Hidden from the listing while they are being worked on — re-enable later.
// (Kept in system-design-sections.ts because the section routes read from there.)
const hiddenSections = ['platforms', 'piyush-garg'];
---

<BaseLayout
    title="System Design"
    description="Free system design notes by Bhuvnesh Verma: caching, sharding, CAP, consensus, queues and more, explained with trade-offs, diagrams and real-world examples."
    showHeader={false}
>
    <h1 class="sr-only">System Design</h1>
    {
        systemDesignSections.map((section, i) => {
            if (hiddenSections.includes(section.id)) return null;
            const sectionPosts = posts.filter((post) => post.data.section === section.id);
            if (sectionPosts.length === 0) return null;
            return (
                <div id={section.id} class="group mb-12 scroll-mt-8 sm:mb-16">
                    <a href={`/system-design/${section.id}/`}>
                        <h2 class="font-sans text-lg font-medium transition group-hover:opacity-60">
                            {section.title}
                        </h2>
                    </a>
                    <p class="mt-2 leading-relaxed text-main/70 transition group-hover:opacity-60">{section.description}</p>
                </div>
            );
        })
    }
    <div class="group mb-12 scroll-mt-8 sm:mb-16">
        <a href="/system-design-roadmap/" class="inline-flex items-center gap-2">
            <h2 class="font-sans text-lg font-medium transition group-hover:opacity-60">roadmap</h2>
            <ArrowRight class="h-4 w-4 fill-current opacity-60 transition group-hover:opacity-100" />
        </a>
        <p class="mt-2 leading-relaxed text-main/70 transition group-hover:opacity-60">
            The building blocks every distributed system stands on — scaling, caching, storage and the trade-offs
            between them.
        </p>
    </div>
</BaseLayout>
