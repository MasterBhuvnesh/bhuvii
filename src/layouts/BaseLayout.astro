---
import { ClientRouter } from 'astro:transitions';
import '@fontsource/dm-sans/latin-300.css';
import '@fontsource/dm-sans/latin-500.css';
import '@fontsource/dm-sans/latin-700.css';
import BaseHead, { type Props as HeadProps } from '../components/BaseHead.astro';
import Nav from '../components/Nav.astro';

export type Props = HeadProps & { showHeader?: boolean };

const { showHeader: _showHeader = true, ...head } = Astro.props;
const year = new Date().getFullYear();
---

<!doctype html>
<html lang="en" class="wrap-break-words antialiased">
    <head>
        <BaseHead {...head} />
        <script is:inline>
            try {
                if (localStorage.theme === 'dark' || (!('theme' in localStorage) && window.matchMedia('(prefers-color-scheme: dark)').matches)) {
                    document.documentElement.classList.add('dark');
                }
            } catch {}
        </script>
        <ClientRouter />
        <script is:inline src="/theme-toggle.js"></script>
    </head>
    <body class="bg-main text-main">
        <div class="flex min-h-screen flex-col px-4 md:px-8">
            <Nav />
            <main class="mx-auto w-full max-w-3xl grow">
                <slot />
            </main>
            <footer class="mx-auto w-full max-w-3xl pb-10">
                <div
                    class="text-main/70 flex flex-wrap items-center justify-between gap-x-4 gap-y-2 border-t pt-6 text-sm border-[color-mix(in_oklab,var(--text-main)_15%,transparent)]"
                >
                    <p>&copy; {year} Bhuvnesh Verma</p>
                    <p class="flex items-center gap-4">
                        <a
                            href="https://github.com/MasterBhuvnesh"
                            target="_blank"
                            rel="noopener noreferrer"
                            class="hover:text-main transition-colors"
                        >
                            GitHub
                        </a>
                        <a
                            href="https://www.linkedin.com/in/bhuvneshverma/"
                            target="_blank"
                            rel="noopener noreferrer"
                            class="hover:text-main transition-colors"
                        >
                            LinkedIn
                        </a>
                    </p>
                </div>
            </footer>
        </div>
    </body>
</html>
