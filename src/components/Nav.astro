---
import NavLink from './NavLink.astro';
import ThemeToggle from './ThemeToggle.astro';
import siteConfig from '../data/site-config';

const navLinks = siteConfig.headerNavLinks ?? [];
---

<nav class="relative min-h-10 pt-4 pb-12 sm:min-h-14 sm:pb-24 md:pt-8" aria-label="Primary navigation">
    {navLinks.length > 0 && (
        <div class="relative mx-auto flex w-full max-w-3xl items-center justify-between gap-3">
            <NavLink href="/" class="font-sans text-lg md:text-base" aria-label="Home">
                bhuvii
            </NavLink>
            <ul class="hidden gap-6 md:flex md:justify-end md:pr-12">
                {navLinks.map((link) => (
                    <li class="py-1">
                        <NavLink class="text-main font-sans text-xl md:text-base" href={link.href}>
                            {link.text}
                        </NavLink>
                    </li>
                ))}
            </ul>
        </div>
    )}
    <div class="absolute top-4 right-0 z-10 flex items-center gap-4 md:top-8">
        {navLinks.length > 0 && (
            <button
                id="menu-button"
                class="flex h-8 cursor-pointer items-center justify-center text-sm transition-opacity hover:opacity-70 md:hidden"
                aria-label="Open Menu"
                aria-expanded="false"
                aria-controls="bottom-sheet"
            >
                <span id="menu-label">menu</span>
            </button>
        )}
        <ThemeToggle />
    </div>
    {navLinks.length > 0 && (
        <>
            <div id="sheet-backdrop" class="fixed inset-0 z-40 hidden bg-black/50 md:hidden" aria-hidden="true"></div>
            <div
                id="bottom-sheet"
                class="fixed inset-x-0 bottom-0 z-50 translate-y-full transition-transform duration-300 ease-out md:hidden"
                role="dialog"
                aria-modal="true"
                aria-label="Menu"
                inert
            >
                <div class="rounded-t-2xl bg-main px-6 pt-3 pb-[max(1.5rem,env(safe-area-inset-bottom))] shadow-[0_-12px_40px_rgba(0,0,0,0.35)]">
                    <div class="mx-auto mb-2 h-1 w-10 rounded-full bg-current opacity-20" aria-hidden="true"></div>
                    <nav aria-label="Mobile navigation">
                        {navLinks.map((link) => (
                            <a
                                href={link.href}
                                class="sheet-link block py-3 text-center font-sans text-xl"
                            >
                                {link.text}
                            </a>
                        ))}
                    </nav>
                </div>
            </div>
        </>
    )}
</nav>

<script>
    function bottomSheet() {
        const sheet = document.querySelector('#bottom-sheet');
        const backdrop = document.querySelector('#sheet-backdrop');
        const menuBtn = document.querySelector('#menu-button');
        const menuLabel = document.querySelector('#menu-label');
        if (!sheet || !backdrop || !menuBtn) return;

        const setOpen = (open) => {
            menuBtn.setAttribute('aria-expanded', open ? 'true' : 'false');
            menuBtn.setAttribute('aria-label', open ? 'Close Menu' : 'Open Menu');
            if (menuLabel) menuLabel.textContent = open ? 'close' : 'menu';
            sheet.classList.toggle('translate-y-full', !open);
            backdrop.classList.toggle('hidden', !open);
            document.body.style.overflow = open ? 'hidden' : '';
            if (open) {
                sheet.removeAttribute('inert');
            } else {
                sheet.setAttribute('inert', '');
            }
        };

        menuBtn.addEventListener('click', () => {
            setOpen(menuBtn.getAttribute('aria-expanded') !== 'true');
        });
        backdrop.addEventListener('click', () => setOpen(false));
        sheet.querySelectorAll('.sheet-link').forEach((link) => {
            link.addEventListener('click', () => setOpen(false));
        });
        document.addEventListener('keydown', (event) => {
            if (event.key === 'Escape') setOpen(false);
        });
    }
    bottomSheet();
    document.addEventListener('astro:after-swap', bottomSheet);
</script>
