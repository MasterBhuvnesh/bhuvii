---
/**
 * Personal profile block (name, bio, socials, GitHub stats + contribution graph).
 * GitHub data is fetched at build time so the page ships zero client JS and
 * makes zero runtime third-party requests. If the fetch fails (offline build),
 * the stats/graph sections are hidden gracefully.
 */

type Day = { date: string; level: number; count: number };

const GITHUB_USER = 'MasterBhuvnesh';
const PROFILE_URL = `https://github.com/${GITHUB_USER}`;

let followers: number | null = null;
let publicRepos: number | null = null;
let weeks: Day[][] = [];
let totalContributions = 0;

async function fetchWithTimeout(url: string, headers: Record<string, string>) {
    const ctrl = new AbortController();
    const timer = setTimeout(() => ctrl.abort(), 10000);
    try {
        const res = await fetch(url, { signal: ctrl.signal, headers });
        if (!res.ok) return null;
        return await res.text();
    } catch {
        return null;
    } finally {
        clearTimeout(timer);
    }
}

const [userJson, calendarHtml] = await Promise.all([
    fetchWithTimeout(`https://api.github.com/users/${GITHUB_USER}`, {
        'User-Agent': 'portfolio-build',
        Accept: 'application/vnd.github+json'
    }),
    fetchWithTimeout(`https://github.com/users/${GITHUB_USER}/contributions`, {
        'User-Agent': 'Mozilla/5.0'
    })
]);

if (userJson) {
    try {
        const user = JSON.parse(userJson);
        if (typeof user.followers === 'number') followers = user.followers;
        if (typeof user.public_repos === 'number') publicRepos = user.public_repos;
    } catch {}
}

if (calendarHtml) {
    // Map tooltip text ("N contributions on ...") to cell ids.
    const counts = new Map<string, number>();
    const tooltipRe = /<tool-tip[^>]*for="([^"]+)"[^>]*>([^<]*)<\/tool-tip>/g;
    let tm: RegExpExecArray | null;
    while ((tm = tooltipRe.exec(calendarHtml)) !== null) {
        const num = tm[2].match(/(\d[\d,]*)\s+contribution/);
        counts.set(tm[1], num ? parseInt(num[1].replace(/,/g, ''), 10) : 0);
    }

    // Table rows are weekdays (Sun-Sat); cells across a row are weeks.
    const rows: Day[][] = [];
    for (const rowHtml of calendarHtml.split('<tr').slice(1)) {
        const days: Day[] = [];
        const cellRe = /<td[^>]*>/g;
        let cm: RegExpExecArray | null;
        while ((cm = cellRe.exec(rowHtml)) !== null) {
            const tag = cm[0];
            const date = tag.match(/data-date="(\d{4}-\d{2}-\d{2})"/)?.[1];
            if (!date) continue;
            const level = parseInt(tag.match(/data-level="(\d)"/)?.[1] ?? '0', 10);
            const id = tag.match(/id="([^"]+)"/)?.[1] ?? '';
            const count = counts.get(id) ?? 0;
            days.push({ date, level, count });
        }
        if (days.length > 0) rows.push(days);
    }

    // Transpose to week columns.
    const weekCount = Math.max(...rows.map((r) => r.length));
    for (let w = 0; w < weekCount; w++) {
        const week: Day[] = [];
        for (let d = 0; d < 7; d++) week.push(rows[d]?.[w] ?? { date: '', level: 0, count: 0 });
        weeks.push(week);
    }
    totalContributions = weeks.flat().reduce((sum, day) => sum + day.count, 0);
}

const MONTHS = ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'];
const monthLabels = weeks.map((week, i) => {
    const day = week.find((d) => d.date);
    if (!day) return '';
    const month = MONTHS[parseInt(day.date.slice(5, 7), 10) - 1];
    if (i === 0) return month;
    const prevDay = weeks[i - 1].find((d) => d.date);
    const prevMonth = prevDay ? MONTHS[parseInt(prevDay.date.slice(5, 7), 10) - 1] : '';
    return month === prevMonth ? '' : month;
});

// Grayscale intensity per GitHub level, theme-aware (works in light + dark).
const LEVEL_SHADE = [8, 30, 50, 75, 100];

const githubIcon =
    'M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12';

const linkedinIcon =
    'M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z';

const instagramIcon =
    'M7.0301.084c-1.2768.0602-2.1487.264-2.911.5634-.7888.3075-1.4575.72-2.1228 1.3877-.6652.6677-1.075 1.3368-1.3802 2.127-.2954.7638-.4956 1.6365-.552 2.914-.0564 1.2775-.0689 1.6882-.0626 4.947.0062 3.2586.0206 3.6671.0825 4.9473.061 1.2765.264 2.1482.5635 2.9107.308.7889.72 1.4573 1.388 2.1228.6679.6655 1.3365 1.0743 2.1285 1.38.7632.295 1.6361.4961 2.9134.552 1.2773.056 1.6884.069 4.9462.0627 3.2578-.0062 3.668-.0207 4.9478-.0814 1.28-.0607 2.147-.2652 2.9098-.5633.7889-.3086 1.4578-.72 2.1228-1.3881.665-.6682 1.0745-1.3378 1.3795-2.1284.2957-.7632.4966-1.636.552-2.9124.056-1.2809.0692-1.6898.063-4.948-.0063-3.2583-.021-3.6668-.0817-4.9465-.0607-1.2797-.264-2.1487-.5633-2.9117-.3084-.7889-.72-1.4568-1.3876-2.1228C21.2982 1.33 20.628.9208 19.8378.6165 19.074.321 18.2017.1197 16.9244.0645 15.6471.0093 15.236-.005 11.977.0014 8.718.0076 8.31.0215 7.0301.0839m.1402 21.6932c-1.17-.0509-1.8053-.2453-2.2287-.408-.5606-.216-.96-.4771-1.3819-.895-.422-.4178-.6811-.8186-.9-1.378-.1644-.4234-.3624-1.058-.4171-2.228-.0595-1.2645-.072-1.6442-.079-4.848-.007-3.2037.0053-3.583.0607-4.848.05-1.169.2456-1.805.408-2.2282.216-.5613.4762-.96.895-1.3816.4188-.4217.8184-.6814 1.3783-.9003.423-.1651 1.0575-.3614 2.227-.4171 1.2655-.06 1.6447-.072 4.848-.079 3.2033-.007 3.5835.005 4.8495.0608 1.169.0508 1.8053.2445 2.228.408.5608.216.96.4754 1.3816.895.4217.4194.6816.8176.9005 1.3787.1653.4217.3617 1.056.4169 2.2263.0602 1.2655.0739 1.645.0796 4.848.0058 3.203-.0055 3.5834-.061 4.848-.051 1.17-.245 1.8055-.408 2.2294-.216.5604-.4763.96-.8954 1.3814-.419.4215-.8181.6811-1.3783.9-.4224.1649-1.0577.3617-2.2262.4174-1.2656.0595-1.6448.072-4.8493.079-3.2045.007-3.5825-.006-4.848-.0608M16.953 5.5864A1.44 1.44 0 1 0 18.39 4.144a1.44 1.44 0 0 0-1.437 1.4424M5.8385 12.012c.0067 3.4032 2.7706 6.1557 6.173 6.1493 3.4026-.0065 6.157-2.7701 6.1506-6.1733-.0065-3.4032-2.771-6.1565-6.174-6.1498-3.403.0067-6.156 2.771-6.1496 6.1738M8 12.0077a4 4 0 1 1 4.008 3.9921A3.9996 3.9996 0 0 1 8 12.0077';
---

<section class="profile-stagger mb-10 w-full sm:mb-12" aria-label="Profile">
    <!-- Initials sit behind the photo; if the photo fails to load it removes itself and the initials show. -->
    <span class="relative flex h-24 w-24 items-center justify-center rounded-full bg-[color-mix(in_oklab,var(--text-main)_10%,transparent)] text-2xl font-medium">
        <span aria-hidden="true">BV</span>
        <img
            src="/bhuvii-192.webp"
            alt="Bhuvnesh Verma"
            width="96"
            height="96"
            fetchpriority="high"
            decoding="async"
            onerror="this.remove()"
            class="absolute inset-0 h-24 w-24 rounded-full object-cover"
        />
    </span>
    <h1 class="mt-4 text-left text-lg font-medium">Bhuvnesh Verma</h1>
    <p class="text-main/70 mt-2 leading-relaxed">Product Engineer, Cloud-Native Builder, AI Systems Creator</p>
    <p class="text-main/70 mt-4 leading-relaxed">
        I design, build, and scale reliable systems used by real people. I work across web, mobile, cloud, and AI, automating
        repetitive work so teams ship faster, and making sure what goes live is stable and ready to grow.
    </p>
    <!-- Commented out for now — re-enable when wanted:
    <p class="text-main/70 mt-4 leading-relaxed">
        B.Tech CSE (AI & ML), Ramdeobaba University, Nagpur · Class of 2027
    </p>
    -->
    <a
        href="https://images.bhuvneshverma.dev/resume.pdf"
        target="_blank"
        rel="noopener noreferrer"
        class="mt-6 inline-flex items-center gap-2 rounded-md bg-[color-mix(in_oklab,var(--text-main)_80%,var(--bg-main))] px-4 py-2 text-sm font-medium text-[var(--bg-main)] transition-transform hover:-translate-y-0.5"
    >
        <svg
            class="h-4 w-4"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
        >
            <path d="M12 3v12m0 0 4-4m-4 4-4-4M4 17v2a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-2" />
        </svg>
        Download CV
    </a>

    <div class="mt-6">
        <p class="font-medium">Key skills:</p>
        <div class="mt-3 flex flex-wrap gap-2">
            {
                [
                    'GenAI systems & agents',
                    'Cloud infrastructure as code',
                    'Backend engineering & APIs',
                    'System design & architecture',
                    'Reliability & performance engineering',
                    'Real-time systems',
                    'CI/CD & release engineering'
                ].map((skill) => (
                    <span class="rounded bg-muted px-3 py-1.5 text-sm text-main">{skill}</span>
                ))
            }
        </div>
    </div>

    <div class="mt-8 flex items-center gap-5">
        <a
            class="text-main/70 transition-colors hover:text-main"
            href={PROFILE_URL}
            target="_blank"
            rel="noopener noreferrer"
            aria-label="GitHub"
        >
            <svg class="h-5 w-5 fill-current" viewBox="0 0 24 24" aria-hidden="true"><path d={githubIcon} /></svg>
        </a>
        <a
            class="text-main/70 transition-colors hover:text-main"
            href="https://www.linkedin.com/in/bhuvneshverma/"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="LinkedIn"
        >
            <svg class="h-5 w-5 fill-current" viewBox="0 0 24 24" aria-hidden="true"><path d={linkedinIcon} /></svg>
        </a>
        <a
            class="text-main/70 transition-colors hover:text-main"
            href="https://www.instagram.com/vermaji_2904/"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="Instagram"
        >
            <svg class="h-5 w-5 fill-current" viewBox="0 0 24 24" aria-hidden="true"><path d={instagramIcon} /></svg>
        </a>
    </div>

    {
        (followers !== null || publicRepos !== null) && (
            <p class="text-main/70 mt-6 flex items-center gap-2 text-sm">
                <svg class="h-3.5 w-3.5 fill-current" viewBox="0 0 24 24" aria-hidden="true">
                    <path d={githubIcon} />
                </svg>
                <span>
                    {followers !== null && <span>{followers} followers</span>}
                    {followers !== null && publicRepos !== null && <span class="mx-1">·</span>}
                    {publicRepos !== null && <span>{publicRepos} repos</span>}
                </span>
            </p>
        )
    }

    {
        weeks.length > 0 && (
            <div class="mt-8">
                <p class="text-sm tracking-widest text-main/70 uppercase">Activity</p>
                <p class="text-main/70 mt-2 text-sm">
                    {totalContributions} GitHub contributions over the last year.
                </p>
                <div class="graph-scroll mt-4 overflow-x-auto pb-1">
                    <div class="w-max">
                        <div class="grid grid-flow-col gap-[3px]" style="grid-auto-columns: 10px">
                            {monthLabels.map((label) => (
                                <span class="w-[10px] overflow-visible text-[10px] whitespace-nowrap text-main/70">
                                    {label}
                                </span>
                            ))}
                        </div>
                        <div
                            class="mt-1 grid grid-flow-col grid-rows-7 gap-[3px]"
                            style="grid-auto-columns: 10px; grid-auto-rows: 10px"
                            role="img"
                            aria-label={`GitHub contribution graph, ${totalContributions} contributions in the last year`}
                        >
                            {weeks.map((week) =>
                                week.map((day) =>
                                    day.date ? (
                                        <span
                                            class="h-[10px] w-[10px] rounded-[2px]"
                                            style={`background-color: color-mix(in oklab, var(--text-main) ${LEVEL_SHADE[Math.min(day.level, 4)]}%, transparent)`}
                                            title={`${day.count} contributions on ${day.date}`}
                                        />
                                    ) : (
                                        <span class="h-[10px] w-[10px]" />
                                    )
                                )
                            )}
                        </div>
                        <div class="mt-2 flex items-center justify-end gap-1 text-[10px] text-main/70">
                            <span class="mr-1">less</span>
                            {LEVEL_SHADE.map((shade) => (
                                <span
                                    class="h-[10px] w-[10px] rounded-[2px]"
                                    style={`background-color: color-mix(in oklab, var(--text-main) ${shade}%, transparent)`}
                                />
                            ))}
                            <span class="ml-1">more</span>
                        </div>
                    </div>
                </div>
            </div>
        )
    }
</section>
