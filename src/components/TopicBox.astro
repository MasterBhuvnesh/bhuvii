---
/**
 * Roadmap topic box: bordered chip. Styling matches the other roadmap boxes exactly.
 */
type Props = {
    title: string;
    class?: string;
};

const { title, class: className } = Astro.props;
const boxClass =
    'rounded-md border-2 border-[var(--text-main)] bg-[color-mix(in_oklab,var(--text-main)_8%,transparent)] px-4 py-2 text-center text-sm font-medium text-main';
---

<div class:list={[boxClass, className]}>{title}</div>
