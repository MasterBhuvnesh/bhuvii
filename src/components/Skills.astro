---
/**
 * Skills section on the landing page: capability chips plus a
 * Technologies & tools row with brand icons inlined from svgl.app
 * (Prometheus from cncf/artwork; no runtime requests, fixed light
 * tiles so dark glyphs read in both themes).
 */

const skills = [
    'GenAI systems & agents',
    'Cloud infrastructure as code',
    'Backend engineering & APIs',
    'System design & architecture',
    'Reliability & performance engineering',
    'Real-time systems',
    'CI/CD & release engineering',
    'Frontend Engineering',
    'Mobile Apps',
    'Database Systems',
    'Caching Systems',
    'Distributed Systems',
    'RAG Pipelines',
    'Auth Systems',
    'Observability'
];
---

<section class="mb-16 w-full sm:mb-24" aria-label="Skills">
    <p class="text-sm tracking-widest text-main/70 uppercase">Skills</p>
    <div class="mt-4 flex flex-wrap gap-2">
        {
            skills.map((skill) => (
                <span class="rounded bg-muted px-3 py-1.5 text-sm text-main">{skill}</span>
            ))
        }
    </div>
    <p class="mt-6 font-medium">Technologies & tools:</p>
