---
/**
 * Selected projects on the landing page. Details sourced from GitHub
 * (MasterBhuvnesh/WCL, /skarm, /studzee); kept static so the page
 * ships zero client JS.
 */


type Project = {
    name: string;
    description: string;
    repo: string;
    live?: string;
    liveLabel?: string;
    status?: string;
    statusNote?: string;
    language: string;
    tags: string[];
};

const projects: Project[] = [
    {
        name: 'Skarm',
        description:
            'Production-ready issue tracking platform for modern teams — real-time Kanban boards, AI-powered triage, multi-team workspaces, cycles, and keyboard-first workflows.',
        repo: 'https://github.com/MasterBhuvnesh/skarm',
        live: 'https://skarm.vercel.app/',
        language: 'TypeScript',
        tags: ['Next.js', 'Convex', 'Realtime', 'AI Triage']
    },
    {
        name: 'Studzee',
        description:
            'Document-to-learning SaaS: upload documents once, study as lessons, summaries, and quizzes across mobile and desktop — one TypeScript API (MongoDB, PostgreSQL, Redis) with AI generation on the roadmap.',
        repo: 'https://github.com/MasterBhuvnesh/studzee',
        live: 'https://studzee.in/',
        language: 'TypeScript',
        tags: ['Expo', 'Kubernetes', 'Redis', 'Clerk', 'Lambda', 'AI']
    },
    {
        name: 'WCL',
        description:
            'Enterprise-grade examination infrastructure powering live assessments at RBU Nagpur for Western Coalfields Limited. Secure Electron exam client, admin console, hall ticket & result portals, real-time monitoring, Bun/Express APIs, PostgreSQL, Redis, and automated evaluation pipeline.',
        repo: 'https://github.com/MasterBhuvnesh/WCL',
        live: 'https://rbuexam.in',
        language: 'TypeScript',
        tags: ['Electron', 'Next.js', 'PostgreSQL', 'Redis', 'AWS'],
        status: 'Not hosted',
        statusNote:
            'Built for Western Coalfields Limited, Nagpur as an examination platform. Hosting has since been handed over, so a live demo is unavailable.'
    }
];
---

<section class="mb-16 w-full sm:mb-24" aria-label="Projects">
    <h2 class="reveal text-sm tracking-widest text-main/70 uppercase">Projects</h2>
    <p class="reveal text-main/70 mt-2 text-sm">A few of the projects I'm working on right now.</p>
    <div class="mt-4 grid gap-4 md:grid-cols-3">
        {
            projects.map((project) => (
                <article class="reveal project-card flex flex-col rounded-md border-2 border-[color-mix(in_oklab,var(--text-main)_35%,transparent)] bg-muted px-5 py-4 transition-transform hover:-translate-y-0.5">
                    <h3 class="text-balance font-medium text-main">
                        <a
                            href={project.repo}
                            target="_blank"
                            rel="noopener noreferrer"
                            class="underline decoration-2 underline-offset-2 decoration-[color-mix(in_oklab,var(--text-main)_40%,transparent)] hover:decoration-[var(--text-main)]"
                        >
                            {project.name}
                        </a>
                    </h3>
                    <p class="mt-2 flex-1 text-sm leading-relaxed text-main/70">{project.description}</p>
                    <div class="mt-3 flex flex-wrap gap-1.5">
                        {project.tags.map((tag) => (
                            <span class="rounded border border-[color-mix(in_oklab,var(--text-main)_40%,transparent)] px-1.5 py-0.5 text-xs text-main/70">
                                {tag}
                            </span>
                        ))}
                    </div>
                    <p class="mt-3 flex items-center gap-3 text-xs text-main/70">
                        <span>{project.language}</span>
                        {project.live &&
                            (project.statusNote ? (
                                <span class="group relative inline-flex" tabindex="0">
                                    <span class="inline-flex cursor-help items-center gap-1.5 underline underline-offset-2">
                                        <span class="h-1.5 w-1.5 rounded-full bg-amber-400"></span>
                                        {project.status ?? project.liveLabel ?? 'Live'}
                                    </span>
                                    <span class="pointer-events-none absolute bottom-full left-0 z-10 mb-2 hidden w-64 rounded-lg bg-[color-mix(in_oklab,var(--text-main)_90%,var(--bg-main))] p-3 text-left shadow-xl group-hover:block group-focus-within:block">
                                        <span class="flex items-center justify-between gap-2 text-xs font-medium text-[var(--bg-main)]">
                                            <span class="inline-flex items-center gap-1.5">
                                                <svg
                                                    class="h-3.5 w-3.5"
                                                    viewBox="0 0 24 24"
                                                    fill="none"
                                                    stroke="currentColor"
                                                    stroke-width="2"
                                                    aria-hidden="true"
                                                >
                                                    <circle cx="12" cy="12" r="10" />
                                                    <path d="M2 12h20M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z" />
                                                </svg>
                                                westerncoal.in
                                            </span>
                                            <span aria-hidden="true">↗</span>
                                        </span>
                                        <span class="mt-2 block text-sm leading-relaxed text-[color-mix(in_oklab,var(--bg-main)_85%,transparent)]">
                                            "{project.statusNote}"
                                        </span>
                                    </span>
                                </span>
                            ) : (
                                <a
                                    href={project.live}
                                    target="_blank"
                                    rel="noopener noreferrer"
                                    class="inline-flex items-center gap-1.5 underline underline-offset-2 hover:text-main"
                                >
                                    <span class="h-1.5 w-1.5 rounded-full bg-emerald-400"></span>
                                    {project.liveLabel ?? 'Live'}
                                </a>
                            ))}
                    </p>
                </article>
            ))
        }
    </div>
</section>
