---
import dmSans300Woff2 from '@fontsource/dm-sans/files/dm-sans-latin-300-normal.woff2?url';
import { getImage } from 'astro:assets';
import siteConfig, { bio } from '../data/site-config';
import type { ImageInput } from '../types';

import '../styles/global.css';

export type Props = {
    title?: string;
    description?: string;
    image?: ImageInput | undefined;
    pageType?: 'website' | 'article';
    noindex?: boolean;
    /** Extra JSON-LD nodes appended to the site-wide @graph. */
    schema?: Record<string, unknown>[];
};

const { description = '', pageType = 'website', noindex = false, schema = [] } = Astro.props;
// Untitled pages (the home page) lead with the name, which is what people search for.
const title = Astro.props.title ? `${Astro.props.title} | ${siteConfig.title}` : `${siteConfig.title} | ${siteConfig.subtitle}`;
const image = Astro.props.image ?? siteConfig.image;
let resolvedImage: { src: string; alt?: string } | undefined;
if (image?.src) {
    if (typeof image.src === 'string') {
        resolvedImage = {
            src: new URL(image.src, Astro.site).toString(),
            alt: image.alt
        };
    } else {
        const optimizedImage = await getImage({
            src: image.src as ImageMetadata,
            width: 1200,
            height: 630,
            format: 'jpeg',
            fit: 'cover'
        });
        resolvedImage = {
            src: new URL(optimizedImage.src, Astro.site).toString(),
            alt: image.alt
        };
    }
}

/**
 * Canonical URL uses the configured `site`.
 * Query parameters are removed because the theme does not generate
 * query-specific content and inbound parameters are typically for tracking.
 * Trailing slashes follow the user's Astro configuration.
 */
const canonicalURL = new URL(Astro.url.pathname, Astro.site);

/**
 * Site-wide JSON-LD: Person + WebSite so search engines connect the
 * portfolio, the author, and the profiles. Factual data only.
 */
const personId = new URL('/#bhuvneshverma', Astro.site).toString();
const siteSchema = {
    '@context': 'https://schema.org',
    '@graph': [
        {
            '@type': 'Person',
            '@id': personId,
            name: 'Bhuvnesh Verma',
            url: new URL('/', Astro.site).toString(),
            image: new URL('/bhuvii-512.jpg', Astro.site).toString(),
            jobTitle: siteConfig.subtitle,
            description: bio,
            address: { '@type': 'PostalAddress', addressLocality: 'Nagpur', addressCountry: 'IN' },
            alumniOf: {
                '@type': 'CollegeOrUniversity',
                name: 'Ramdeobaba University',
                alternateName: 'Shri Ramdeobaba College of Engineering and Management'
            },
            knowsAbout: [
                'System Design',
                'Distributed Systems',
                'Cloud-Native Architecture',
                'Full-Stack Web Development',
                'Mobile App Development',
                'Generative AI',
                'TypeScript',
                'Python',
                'Cloudflare Workers',
                'MongoDB',
                'Supabase'
            ],
            sameAs: [
                'https://github.com/MasterBhuvnesh',
                'https://www.linkedin.com/in/bhuvneshverma/',
                'https://www.instagram.com/vermaji_2904/'
            ]
        },
        {
            '@type': 'WebSite',
            '@id': new URL('/#website', Astro.site).toString(),
            url: new URL('/', Astro.site).toString(),
            name: 'Bhuvnesh Verma',
            publisher: { '@id': personId }
        },
        ...schema
    ]
};
---

<!-- High Priority Global Metadata -->
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1" />
<title>{title}</title>
<meta name="generator" content={Astro.generator} />

<!-- Fonts -->
<link rel="preload" as="font" type="font/woff2" href={dmSans300Woff2} crossorigin="anonymous" />

<!-- Low Priority Global Metadata -->
<!-- Icons (profile photo) -->
<link rel="icon" href="/favicon.ico" sizes="48x48" />
<link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
<link rel="icon" type="image/png" sizes="16x16" href="/favicon-16.png" />
<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
<link rel="manifest" href="/site.webmanifest" />
<meta name="theme-color" media="(prefers-color-scheme: light)" content="#f2f1ec" />
<meta name="theme-color" media="(prefers-color-scheme: dark)" content="#171717" />
<link rel="sitemap" href="/sitemap-index.xml" />

<!-- Page Metadata -->
<link rel="canonical" href={canonicalURL} />
<meta name="description" content={description} />
<meta name="robots" content={noindex ? 'noindex, follow' : 'index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1'} />
<meta name="author" content="Bhuvnesh Verma" />

<!-- Open Graph / Facebook -->
<meta property="og:type" content={pageType} />
<meta property="og:url" content={canonicalURL} />
<meta property="og:title" content={title} />
{description && <meta property="og:description" content={description} />}
{resolvedImage?.src && <meta property="og:image" content={resolvedImage.src} />}
{resolvedImage?.alt && <meta property="og:image:alt" content={resolvedImage.alt} />}

<!-- X/Twitter -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:url" content={canonicalURL} />
<meta name="twitter:title" content={title} />
{description && <meta name="twitter:description" content={description} />}
{resolvedImage?.src && <meta name="twitter:image" content={resolvedImage.src} />}
{resolvedImage?.alt && <meta name="twitter:image:alt" content={resolvedImage.alt} />}

<!-- Structured data -->
<script type="application/ld+json" set:html={JSON.stringify(siteSchema)} />
